# Kernel config fragment for the A13 tablet, applied on top of sunxi_defconfig:
#   make ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- sunxi_defconfig
#   ./scripts/kconfig/merge_config.sh -m .config /path/to/kernel-a13-tablet.config
#   make ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- olddefconfig

# Framebuffer console (without it the screen freezes on "Starting kernel ...")
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_DRM_SIMPLEDRM is not set

# Display: DRM, panel, PWM backlight
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_PWM_SUN4I=y
CONFIG_BACKLIGHT_PWM=y

# AXP209 GPIOs (LCD power, backlight enable); without it DRM never binds
CONFIG_PINCTRL_AXP209=y

# USB OTG gadget serial console (debugging / first boot only)
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y

# Wi-Fi RTL8188C family (0bda:018a)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL_CARDS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m

# systemd requirements
CONFIG_CGROUPS=y
CONFIG_AUTOFS_FS=y
CONFIG_FHANDLE=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
